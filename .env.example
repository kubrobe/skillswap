# Copy this file to ".env" (exactly that name) and fill in your values. NEVER commit .env to GitHub.

# PostgreSQL. Local example:
DATABASE_URL=postgres://skillswap:skillswap@localhost:5432/skillswap
# Hosted example (Supabase "connection pooler" string):
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Only if your provider uses its own certificate authority: paste its CA certificate here (PEM text)
# DB_SSL_CA=

# MongoDB (optional: reviews + activity statistics). Local example or an Atlas connection string:
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=skillswap

PORT=3000

# Sign in with Google (optional). The WEB client id from Google Cloud Console (see docs/GOOGLE_SIGN_IN.md).
# The same id is used by the website button and by the Android app. Without it, no Google button is shown.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
