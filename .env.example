# Copy this file to ".env" (exactly that name) and fill in your values. NEVER commit .env to GitHub.

# PostgreSQL. Local example:
DATABASE_URL=postgres://skillswap:skillswap@localhost:5432/skillswap
# Hosted example (Supabase "connection pooler" string):
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Only if your provider uses its own certificate authority: paste its CA certificate here (PEM text)
# DB_SSL_CA=

# MongoDB (optional: reviews + activity statistics). Local example or an Atlas connection string:
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=skillswap

PORT=3000

# Sign in with Google (optional). The WEB client id from Google Cloud Console (see docs/GOOGLE_SIGN_IN.md).
# The same id is used by the website button and by the Android app. Without it, no Google button is shown.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Video lessons: TURN relay (optional but strongly recommended; see docs/VIDEO_ROOMS.md).
# Cloudflare Realtime TURN key. The server turns it into short-lived credentials; it never reaches the phones.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=

# Telegram bot (optional): "Continue with Telegram" login, booking alerts and lesson reminders.
# Create the bot with @BotFather in Telegram (/newbot) and paste its token here. SECRET: keep it only in .env
# and in Render -> Environment, never in the code (this repository is public).
# TELEGRAM_BOT_TOKEN=123456789:AA...
# The bot's username without "@" (optional: the server can ask Telegram for it).
# TELEGRAM_BOT_USERNAME=SkillSwapUzBot
# The short names BOT_TOKEN and BOT_USERNAME work too.
# The public address of this server. Render sets RENDER_EXTERNAL_URL by itself; elsewhere set PUBLIC_URL so
# Telegram can call the webhook. With neither (your own computer) the server reads messages with long polling.
# PUBLIC_URL=https://your-site.example.com
